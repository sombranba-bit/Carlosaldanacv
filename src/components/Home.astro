---
import Base from '../layouts/Base.astro';
import * as es from '../data/cv';
import * as en from '../data/cv.en';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const { profile, projects, experience, education, certs, skills, about, ui, ext, chart, stats } = lang === 'en' ? en : es;
import { appIcons } from '../data/icons';
import { detail } from '../data/projects-detail';
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const initials = (s: string) => s.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<Base title={`${profile.name} · ${profile.title}`} lang={lang}>
  <section class="hero">
    <div class="hero-content">
      {profile.available && <p class="avail"><span class="avail-dot" aria-hidden="true"></span>{ui.available}</p>}
      <h1 class="hero-title">
        <span class="line line-dev">{ext.heroLine1}</span>
        <span class="line line-accent">{ext.heroLine2}</span>
      </h1>
      <p class="hero-sub">{profile.tagline}. {ui.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary magnetic" href={`${root}${ui.prefix}/proyectos`}>{ui.projects}</a>
        <a class="btn btn-ghost magnetic" href={root + "/cv.pdf"} download>{ui.cv}</a>
      </div>
      <p class="hero-badge"><span aria-hidden="true">✓</span> {profile.badge}</p>
      <div class="tacho" aria-hidden="true" data-labels={JSON.stringify(chart.labels)} data-now={chart.now}>
      <div class="tacho-plot">
        {chart.lanes.map((segs, li) => (
          <div class="lane">
            <span class="lane-label">{chart.labels[li]}</span>
            <div class="track">
              {segs.map(([a, b], si) => (
                <span class={`seg seg-${li}`} data-lane={li} data-a={a} data-b={b} style={`left:${(a / 24 * 100).toFixed(2)}%;width:${((b - a) / 24 * 100).toFixed(2)}%;--d:${(li * 0.35 + si * 0.12).toFixed(2)}s`}></span>
              ))}
            </div>
          </div>
        ))}
        <div class="needle-rail"><div class="trail"></div><span class="needle"></span></div>
      </div>
      <div class="tacho-hours"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
      <p class="tacho-status mono"><span class="dot"></span><span class="status-text">{chart.now}</span></p>
      <p class="tacho-note mono">{chart.note}</p>
    </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true"><span>Scroll</span><div class="line-v"></div></div>
  </section>

  <section class="stats" aria-label={ui.workTitle}>
    {stats.map((st) => (
      <div class="stat reveal">
        {st.gauge !== false && (
        <svg class="gauge" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="46" stroke="#ffffff30" fill="none"/>
          <g stroke="#ffffff50" stroke-width="1">
            {Array.from({ length: 28 }, (_, i) => { const a = (-135 + i * 10) * Math.PI / 180; const r1 = i % 3 === 0 ? 36 : 41; return <line x1={50 + 46 * Math.sin(a)} y1={50 - 46 * Math.cos(a)} x2={50 + r1 * Math.sin(a)} y2={50 - r1 * Math.cos(a)} />; })}
          </g>
          <g class="gauge-needle" data-angle={(-135 + 270 * st.to / 700).toFixed(1)}><line x1="50" y1="50" x2="50" y2="8" stroke="#ffb000" stroke-width="2"/></g>
          <circle cx="50" cy="50" r="3.5" fill="#ffb000"/>
        </svg>
        )}
        <span class="stat-num" data-to={st.to} data-prefix={st.prefix} data-suffix={st.suffix}>{st.prefix}{st.to}{st.suffix}</span>
        <span class="stat-label">{st.label}</span>
      </div>
    ))}
  </section>

  <section class="section" id="acerca">
    <div class="section-head"><h2 class="gradient">{ui.aboutTitle}</h2></div>
    <div class="about">
      <div>{about.map((t, i) => <p class="reveal" style={`--d:${i * 0.1}s`}>{t}</p>)}</div>
      <figure class="about-photo reveal"><img src={root + "/avatar.jpg"} alt={profile.name} loading="lazy" /></figure>
    </div>
  </section>

  <section class="section" id="trabajo">
    <div class="section-head reveal">
      <span class="section-no">01</span>
      <div>
        <h2 class="gradient">{ui.workTitle}</h2>
        <p class="section-sub">{ui.workSub}</p>
      </div>
    </div>
    <div class="grid-cards">
      {projects.slice(0, 3).map((p, i) => (
        <a class="project-card reveal" href={`${root}${ui.prefix}/proyectos/${detail[lang][i].slug}`} style={`--d:${i * 0.1}s`}>
          <div class="thumb"><span class="app-icon is-pro" data-tone={i} set:html={appIcons[i]} /></div>
          <div class="card-body">
            <span class="card-year">{detail[lang][i].year}</span>
            <h3>{p.name}</h3>
            <p class="summary">{p.desc}</p>
            <ul class="tech">{p.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        </a>
      ))}
    </div>
    <div class="view-all-wrap reveal">
      <a class="view-all magnetic" href={`${root}${ui.prefix}/proyectos`}>{ui.allProjects} ({projects.length}) <span class="arrow">→</span></a>
    </div>
  </section>

  <section class="section" id="experiencia">
    <div class="section-head reveal">
      <span class="section-no">02</span>
      <h2 class="gradient">{ui.experience}</h2>
    </div>
    <div class="exp-layout">
    <div class="tl-wrap">
    <div class="rail"><div class="rail-fill"></div><span class="truck" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2" y="7" width="12" height="9" rx="1"/><path d="M14 10h4l3 3v3h-7"/><circle cx="6" cy="18" r="1.8" fill="#0b0b0b"/><circle cx="17" cy="18" r="1.8" fill="#0b0b0b"/></svg></span></div>
    <ol class="tl-list">
      {experience.map((j) => (
        <li class="job" data-mark={j.company.includes('Ocón') ? 'ocon' : j.company.includes('Cooperativo') ? 'transcoop' : 'transerveto'}>
          <p class="period">{j.period}</p>
          <h3>{j.role}</h3>
          <p class="company">{j.company}</p>
          <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
        </li>
      ))}
    </ol>
    </div>
    <aside class="exp-stage" aria-hidden="true">
      <div class="stage-inner">
        <img class="mark" data-key="ocon" src={root + "/logos/ocon.png"} alt="" />
        <img class="mark" data-key="transcoop" src={root + "/logos/transcoop.png"} alt="" />
        <img class="mark" data-key="transerveto" src={root + "/logos/transerveto.png"} alt="" />
      </div>
    </aside>
    </div>
  </section>

  <section class="zoom-band reveal" aria-hidden="true">
    <div class="zoom-frame"><img class="zoom-img" src={root + "/foto-zoom.webp"} alt="" loading="lazy"/></div>
  </section>

  <section class="section" id="formacion">
    <div class="section-head reveal">
      <span class="section-no">03</span>
      <h2 class="gradient">{ui.eduTitle}</h2>
    </div>
    <div class="two reveal">
      <div>
        <h3>{ui.education}</h3>
        <ul>{education.map((e) => <li>{e.title}<small>{e.place} · {e.period}</small></li>)}</ul>
      </div>
      <div>
        <h3>{ui.certsTitle}</h3>
        <ul>{certs.map((c) => <li>{c.title}<small>{c.place}</small></li>)}</ul>
      </div>
    </div>
    <div class="skills reveal">
      <h3>{ui.skillsTitle}</h3>
      <ul class="tech">{skills.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>

  <section class="contact-inner" id="contacto">
    <a class="cta-block reveal" href={`mailto:${profile.email}`}>
      <span class="cta-line cta-sans">{ext.contactA}</span>
      <span class="cta-line cta-serif">{ext.contactB}</span>
    </a>
    <ul class="socials reveal">
      <li><a class="social-link" href={`mailto:${profile.email}`}><span class="social-text" data-text={profile.email}>{profile.email}</span></a> <button type="button" class="copy-btn" data-copy={profile.email} data-label-copy={ui.copyEmail} data-label-done={ui.copied}>{ui.copyEmail}</button></li>
      <li><a class="social-link" href={`tel:${profile.phoneHref}`}><span class="social-text" data-text={profile.phone}>{profile.phone}</span></a></li>
      <li><a class="social-link" href={profile.linkedin} target="_blank" rel="noopener"><span class="social-text" data-text="LinkedIn">LinkedIn</span><span class="social-arrow">↗</span></a></li>
      <li><a class="social-link" href={root + "/cv.pdf"} download><span class="social-text" data-text={ui.cv}>{ui.cv}</span><span class="social-arrow">↓</span></a></li>
    </ul>
  </section>
</Base>

<script>
  // Copiar el email al portapapeles, con respaldo si el navegador no lo permite
  function copyButtons() {
    document.querySelectorAll('.copy-btn').forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = '1';
      b.addEventListener('click', async () => {
        const txt = b.dataset.copy;
        let ok = false;
        try { await navigator.clipboard.writeText(txt); ok = true; } catch (e) {}
        b.textContent = ok ? b.dataset.labelDone : b.dataset.labelCopy;
        setTimeout(() => { b.textContent = b.dataset.labelCopy; }, 1800);
      });
    });
  }
  document.addEventListener('astro:page-load', copyButtons);
  copyButtons();

  function init() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Camión que avanza por la línea de experiencia y enciende cada empresa
    const list = document.querySelector('.tl-list');
    const fill = document.querySelector('.rail-fill');
    const truck = document.querySelector('.truck');
    const jobs = [...document.querySelectorAll('.job')];
    const marks = [...document.querySelectorAll('.mark')];
    if (list && fill && truck) {
      let tlraf = 0;
      window.onscroll = () => {
        if (tlraf) return;
        tlraf = requestAnimationFrame(() => {
        tlraf = 0;
        const r = list.getBoundingClientRect();
        const line = innerHeight * 0.6;
        const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
        fill.style.transform = `scaleY(${p})`;
        truck.style.top = `${p * 100}%`;
        jobs.forEach((j) => j.classList.toggle('lit', j.getBoundingClientRect().top < line));
        const lit = jobs.filter((j) => j.classList.contains('lit')).pop();
        const key = lit ? lit.dataset.mark : null;
        marks.forEach((m) => m.classList.toggle('on', m.dataset.key === key));
        });
      };
      window.onscroll();
    }

    // Gráfico de tacógrafo animado: un día completo cada minuto, con aguja, rastro y tramos
    const tac = document.querySelector('.tacho');
    if (tac) {
      const labels = JSON.parse(tac.dataset.labels);
      const segs = [...tac.querySelectorAll('.seg')];
      const trail = tac.querySelector('.trail');
      const needle = tac.querySelector('.needle');
      const text = tac.querySelector('.status-text');
      const cycle = 60000;
      let last = -1;
      const frame = (now) => {
        const h = ((now % cycle) / cycle) * 24;
        const pct = (h / 24) * 100;
        needle.style.left = pct + '%';
        trail.style.width = pct + '%';
        let active = null;
        for (const sg of segs) {
          const a = Number(sg.dataset.a), b = Number(sg.dataset.b);
          sg.classList.toggle('passed', b <= h);
          const on = a <= h && h < b;
          sg.classList.toggle('current', on);
          if (on) active = Number(sg.dataset.lane);
        }
        const hh = String(Math.floor(h)).padStart(2, '0');
        const mm = String(Math.floor((h % 1) * 60)).padStart(2, '0');
        const label = `${hh}:${mm} · ${active === null ? '' : labels[active]}`;
        if (label !== last) { text.textContent = `${tac.dataset.now} ${label}`; last = label; }
        window.__tachoRaf = requestAnimationFrame(frame);
      };
      // Solo se redibuja mientras el gráfico está en pantalla
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { if (!window.__tachoRaf) window.__tachoRaf = requestAnimationFrame(frame); }
        else if (window.__tachoRaf) { cancelAnimationFrame(window.__tachoRaf); window.__tachoRaf = 0; }
      });
      io.observe(tac);
      if (window.__tachoRaf) cancelAnimationFrame(window.__tachoRaf);
      window.__tachoRaf = requestAnimationFrame(frame);
    }

    // Foto con zoom que se ajusta al hacer scroll
    const zimg = document.querySelector('.zoom-img');
    if (zimg && !reduce) {
      let zraf = 0;
      const zoom = () => {
        if (zraf) return;
        zraf = requestAnimationFrame(() => {
          zraf = 0;
          const r = zimg.parentElement.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
          zimg.style.transform = `scale(${1.25 - p * 0.25})`;
        });
      };
      addEventListener('scroll', zoom, { passive: true });
      zoom();
    }

    // Contadores de cifras al entrar en pantalla
    const nums = [...document.querySelectorAll('.stat-num')];
    const run = (el) => {
      const to = Number(el.dataset.to);
      if (reduce) return;
      el.textContent = el.dataset.prefix + '0' + el.dataset.suffix;
      const t0 = performance.now();
      const step = (t) => {
        const k = Math.min(1, (t - t0) / 1600);
        const e = 1 - Math.pow(1 - k, 3);
        el.textContent = el.dataset.prefix + Math.round(to * e) + el.dataset.suffix;
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          const needle = e.target.closest('.stat')?.querySelector('.gauge-needle');
          if (needle) needle.style.transform = `rotate(${needle.dataset.angle}deg)`;
          run(e.target); io.unobserve(e.target);
        }
      }
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));

    // Brillo ámbar que sigue al cursor en las tarjetas de proyectos
    document.querySelectorAll('.project-card').forEach((c) => c.addEventListener('mousemove', (e) => {
      const r = c.getBoundingClientRect();
      c.style.setProperty('--mx', e.clientX - r.left + 'px');
      c.style.setProperty('--my', e.clientY - r.top + 'px');
    }));
  }
  document.addEventListener('astro:page-load', init);
</script>
