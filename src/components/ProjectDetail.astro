---
import Base from '../layouts/Base.astro';
import * as es from '../data/cv';
import * as en from '../data/cv.en';
import { detail } from '../data/projects-detail';
import { appIcons, vehicles } from '../data/icons';

interface Props { lang: 'es' | 'en'; i: number; }
const { lang, i } = Astro.props;
const d = lang === 'en' ? en : es;
const p = d.projects[i];
const info = detail[lang][i];
const tones = ['#ffb000', '#5fe3b0', '#8fb4ff'];
const tone = tones[i];
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const base = root + d.ui.prefix;
const back = lang === 'en' ? '← All projects' : '← Todos los proyectos';
const contactLabel = lang === 'en' ? 'Contact' : 'Contacto';
const laneNames = lang === 'en' ? ['Rigid truck', 'Curtain-sider', 'Tanker', 'Double-trailer'] : ['Camión rígido', 'Camión de lona', 'Camión cisterna', 'Duotrailer'];
const laneKeys = ['rigid', 'lona', 'cisterna', 'duo'] as const;
const mk = lang === 'en'
  ? { k1: 'Infringements', k2: 'Downloads', k3: 'Repeat', cap0: 'Infringements per month', cap1: '— 2026 · · · 2025', ax: ['Jan', 'Mar', 'May', 'Jul', 'Sep', 'Oct'], cap2: 'Drivers with most infringements', cap3: 'Infringements by delegation' }
  : { k1: 'Infracciones', k2: 'Descargas', k3: 'Reincidentes', cap0: 'Infracciones por mes', cap1: '— 2026 · · · 2025', ax: ['ene', 'mar', 'may', 'jul', 'sep', 'oct'], cap2: 'Conductores con más infracciones', cap3: 'Infracciones por delegación' };
const live = lang === 'en' ? 'Try the interactive demo' : 'Ver demo interactiva';
---
<Base title={`${p.name} · ${d.profile.name}`} active="proyectos" lang={lang}>
  <section class="section detail" style={`--tone:${tone}`}>
    <div class="detail-art" aria-hidden="true"></div>
    <a class="detail-back" href={`${base}/proyectos`}>{back}</a>
    <div class="detail-split">
      <div class="detail-text">
        <p class="detail-eyebrow">{info.eyebrow}</p>
        <div class="detail-head">
          <span class="app-icon detail-icon" data-tone={i} set:html={appIcons[i]} />
          <div>
            <h1>{p.name}</h1>
            <p class="detail-tagline">{info.tagline}</p>
          </div>
        </div>
        <p class="detail-body">{info.body}</p>
        <p class="detail-note">{info.note}</p>
        <ul class="detail-chips">
          <li class="chip chip-year">{info.year}</li>
          {p.tags.map((t) => <li class="chip">{t}</li>)}
        </ul>
        {info.demo && <p class="detail-live"><a class="detail-live-link" href={root + info.demo}>{live} <span aria-hidden="true">→</span></a></p>}
        <p class="detail-disclaimer">{info.disclaimer}</p>
      </div>
      <aside class="detail-stage">
        {info.demo ? (
          <div class="device">
            <div class="device-bar"><span></span><span></span><span></span></div>
            <iframe class="device-screen" src={root + info.demo} title={p.name} loading="lazy"></iframe>
          </div>
        ) : (
          <div class="device device-icon">
            <span class="app-icon" data-tone={i} set:html={appIcons[i]} />
          </div>
        )}
      </aside>
    </div>

    <div class="lanes" aria-hidden="true">
      {laneNames.map((name, k) => (
        <div class="lane" data-dir={k % 2 ? 'rev' : 'fwd'}>
          <span class="lane-label">{name}</span>
          <div class="lane-track">
            <div class="lane-road"></div>
            {info.features.map((f, n) => { const x = ((n + 1) / (info.features.length + 1)) * 100; return <span class="lane-stop" data-at={x} style={`left:${x}%`}></span>; })}
            <span class="lane-veh" set:html={vehicles[laneKeys[k]]}></span>
          </div>
        </div>
      ))}
    </div>
    <div class="tl-grid">
      <div class="tl-copy">
        <div class="tl-rail" aria-hidden="true"><div class="tl-rail-fill"></div><span class="tl-truck"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2" y="7" width="12" height="9" rx="1"/><path d="M14 10h4l3 3v3h-7"/><circle cx="6" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg></span></div>
        <ol class="tl-chapters">
          {info.features.map((f, n) => (
            <li class="tl-chapter" data-zone={n % 4} data-cat={f.cat}>
              <span class="tl-stop" aria-hidden="true"></span>
              <span class="tl-num">{String(n + 1).padStart(2, '0')}</span>
              <h3>{f.cat}</h3>
              <p>{f.title}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="tl-stage">
        <div class="tl-sticky" data-zone="0">
          <div class="phone">
            <div class="phone-island"></div>
            <div class="phone-screen">
              <div class="mock-bar"><span></span><span></span><span></span><span></span></div>
              <div class="zone z0"><span class="zone-label"></span><div class="mock-kpis"><div style="--d:0ms"><b>1.284</b><small>{mk.k1}</small></div><div style="--d:120ms"><b>94%</b><small>{mk.k2}</small></div><div style="--d:240ms"><b>27</b><small>{mk.k3}</small></div></div><span class="mock-cap">{mk.cap0}</span><div class="mock-bars"><i style="--h:42%;--d:0ms"></i><i style="--h:55%;--d:70ms"></i><i style="--h:38%;--d:140ms"></i><i style="--h:61%;--d:210ms"></i><i style="--h:48%;--d:280ms"></i><i style="--h:72%;--d:350ms"></i><i style="--h:66%;--d:420ms"></i><i style="--h:58%;--d:490ms"></i><i style="--h:44%;--d:560ms"></i><i style="--h:69%;--d:630ms"></i></div></div>
              <div class="zone z1"><span class="zone-label"></span><svg class="mock-spark" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="spk" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--tone)" stop-opacity=".28"/><stop offset="1" stop-color="var(--tone)" stop-opacity="0"/></linearGradient></defs><path d="M0 10H100M0 20H100M0 30H100" stroke="#ffffff10" fill="none" vector-effect="non-scaling-stroke"/><path class="spk-area" d="M0.0 28.0 L11.11 21.5 L22.22 30.0 L33.33 18.5 L44.44 25.0 L55.56 13.0 L66.67 16.0 L77.78 20.0 L88.89 27.0 L100.0 14.5 L100 40 L0 40 Z" fill="url(#spk)"/><path class="spk-line" pathLength="1" d="M0.0 28.0 L11.11 21.5 L22.22 30.0 L33.33 18.5 L44.44 25.0 L55.56 13.0 L66.67 16.0 L77.78 20.0 L88.89 27.0 L100.0 14.5" fill="none" stroke="var(--tone)" stroke-width="1.6" stroke-linejoin="round" vector-effect="non-scaling-stroke"/><path class="spk-dash" d="M0.0 24.0 L11.11 25.5 L22.22 22.0 L33.33 23.0 L44.44 19.0 L55.56 20.0 L66.67 17.5 L77.78 21.5 L88.89 24.0 L100.0 18.0" fill="none" stroke="#ffffff55" stroke-width="1.2" stroke-dasharray="3 3" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg><span class="mock-cap">{mk.cap1}</span><div class="mock-axis"><span>{mk.ax[0]}</span><span>{mk.ax[1]}</span><span>{mk.ax[2]}</span><span>{mk.ax[3]}</span><span>{mk.ax[4]}</span><span>{mk.ax[5]}</span></div></div>
              <div class="zone z2"><span class="zone-label"></span><span class="mock-cap">{mk.cap2}</span><div class="mock-rows"><p style="--d:200ms"><i></i><span>M. Sánchez</span><em>ZGZ</em><strong>14</strong></p><p style="--d:310ms"><i></i><span>R. Gil</span><em>MAD</em><strong>11</strong></p><p style="--d:420ms"><i></i><span>A. Ortega</span><em>BCN</em><strong>9</strong></p><p style="--d:530ms"><i></i><span>L. Navarro</span><em>ZGZ</em><strong>7</strong></p><p style="--d:640ms"><i></i><span>D. Serrano</span><em>VLC</em><strong>6</strong></p><p style="--d:750ms"><i></i><span>P. Vidal</span><em>MAD</em><strong>4</strong></p></div></div>
              <div class="zone z3"><span class="zone-label"></span><span class="mock-cap">{mk.cap3}</span><div class="mock-deleg"><p style="--d:200ms"><span>Zaragoza</span><i style="--w:92%;--d:300ms"></i><b>412</b></p><p style="--d:340ms"><span>Madrid</span><i style="--w:72%;--d:440ms"></i><b>318</b></p><p style="--d:480ms"><span>Barcelona</span><i style="--w:58%;--d:580ms"></i><b>256</b></p><p style="--d:620ms"><span>Valencia</span><i style="--w:34%;--d:720ms"></i><b>147</b></p></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {info.shots.length > 0 && (
      <div class="detail-shots">
        {info.shots.map((src) => <img src={root + src} alt="" loading="lazy" />)}
      </div>
    )}

    <div class="detail-contact">
      <p class="eyebrow">{contactLabel}</p>
      <a class="cta-block" href={`mailto:${d.profile.email}`}>
        <span class="cta-line cta-sans">{d.ext.contactA}</span>
        <span class="cta-line cta-serif">{d.ext.contactB}</span>
      </a>
      <ul class="socials">
        <li><a class="social-link" href={`mailto:${d.profile.email}`}><span class="social-text" data-text={d.profile.email}>{d.profile.email}</span></a></li>
        <li><a class="social-link" href={`tel:${d.profile.phoneHref}`}><span class="social-text" data-text={d.profile.phone}>{d.profile.phone}</span></a></li>
        <li><a class="social-link" href={d.profile.linkedin} target="_blank" rel="noopener"><span class="social-text" data-text="LinkedIn">LinkedIn</span><span class="social-arrow">↗</span></a></li>
        <li><a class="social-link" href={root + "/cv.pdf"} download><span class="social-text" data-text={d.ui.cv}>{d.ui.cv}</span><span class="social-arrow">↓</span></a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  function timeline() {
    const chapters = [...document.querySelectorAll('.tl-chapter')];
    const sticky = document.querySelector('.tl-sticky');
    const fill = document.querySelector('.tl-rail-fill');
    const truck = document.querySelector('.tl-truck');
    const copy = document.querySelector('.tl-copy');
    const lanesEl = document.querySelector('.lanes');
    if (!chapters.length || !sticky || !copy) return;
    const update = () => {
      const mid = innerHeight * 0.5;
      let active = 0;
      chapters.forEach((c, n) => {
        const r = c.getBoundingClientRect();
        if (r.top < mid) active = n;
        c.classList.toggle('is-reached', r.top < mid);
      });
      const c = chapters[active];
      chapters.forEach((x, n) => x.classList.toggle('is-active', n === active));
      sticky.dataset.zone = c.dataset.zone;
      sticky.querySelectorAll('.mock-bar span').forEach((t, i) => t.classList.toggle('on', i === Number(c.dataset.zone)));
      sticky.querySelectorAll('.zone').forEach((z) => {
        const on = z.classList.contains('z' + c.dataset.zone);
        z.classList.toggle('is-active', on);
        z.querySelector('.zone-label').textContent = on ? c.dataset.cat : '';
      });
      const r = copy.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      if (fill) fill.style.transform = `scaleY(${p})`;
      if (truck) truck.style.top = `${p * 100}%`;
      if (lanesEl) {
        const lr = lanesEl.getBoundingClientRect();
        const lp = Math.min(1, Math.max(0, (mid - lr.top) / (lr.height + mid)));
        lanesEl.querySelectorAll('.lane').forEach((ln) => {
          const pos = ln.dataset.dir === 'rev' ? 1 - lp : lp;
          ln.querySelector('.lane-track').style.setProperty('--p', pos.toFixed(4));
          ln.querySelectorAll('.lane-stop').forEach((st) => {
            st.classList.toggle('is-passed', pos * 100 >= parseFloat(st.dataset.at));
          });
        });
      }
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
  function fx() {
    const dev = document.querySelector('.device');
    if (!dev) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.2 });
    io.observe(dev);
  }
  document.addEventListener('astro:page-load', () => { timeline(); fx(); });
</script>
