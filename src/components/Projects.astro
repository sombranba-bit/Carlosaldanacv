---
import Base from '../layouts/Base.astro';
import * as es from '../data/cv';
import * as en from '../data/cv.en';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const { projects, ui, profile } = lang === 'en' ? en : es;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
import { appIcons } from '../data/icons';
import { detail } from '../data/projects-detail';
---
<Base title={`${ui.projectsTitle} · ${profile.name}`} active="proyectos" lang={lang}>
  <section class="section" style="padding-top:180px">
    <div class="section-head reveal">
      <span class="section-no">01</span>
      <div>
        <h1 class="gradient" style="font-size:clamp(2.4rem,5vw,3.6rem);letter-spacing:-.03em">{ui.projectsTitle}</h1>
        <p class="section-sub">{ui.projectsLead}</p>
      </div>
    </div>
    <div class="grid-cards">
      {projects.map((p, i) => (
        <a class="project-card reveal" href={`${root}${ui.prefix}/proyectos/${detail[lang][i].slug}`} style={`--d:${(i % 3) * 0.1}s`}>
          <div class="thumb"><span class="app-icon is-pro" data-tone={i} set:html={appIcons[i]} /></div>
          <div class="card-body">
            <span class="card-year">{detail[lang][i].year}</span>
            <h3>{p.name}</h3>
            <p class="summary">{p.desc}</p>
            <ul class="tech">{p.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        </a>
      ))}
    </div>
    <div class="view-all-wrap">
      <a class="view-all magnetic" href={`${root}${ui.prefix}/calculadora-plazos/`}>{ui.calcTitle}</a>
      <a class="view-all magnetic" href={`${root}${ui.prefix}/`}>{ui.back}</a>
    </div>
  </section>
</Base>
