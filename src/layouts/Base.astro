---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import * as es from '../data/cv';
import * as en from '../data/cv.en';

interface Props { title: string; active?: string; lang: 'es' | 'en'; }
const { title, active = '', lang } = Astro.props;
const d = lang === 'en' ? en : es;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = root + d.ui.prefix;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="description" content={`${d.profile.title} · ${d.profile.tagline}`} />
    <title>{title}</title>
    <link rel="icon" href={root + "/avatar.jpg"} />
    <link rel="alternate" hreflang="es" href={root + "/"} />
    <link rel="alternate" hreflang="en" href={root + "/en/"} />
    <ClientRouter />
  </head>
  <body>
    <div class="background" aria-hidden="true"><div class="glow"></div><div class="grid" style={`background-image:url(${root}/fondo-tacografo.svg)`}></div></div>
    <header class="nav">
      <div class="nav-inner">
        <a href={`${p}/`} class="brand" aria-label={d.profile.name}>
          <span class="brand-avatar"><img src={root + "/avatar.jpg"} alt="" width="112" height="112" /></span>
        </a>
        <nav class="nav-list">
          <a href={`${p}/proyectos`} class:list={['nav-link', { active: active === 'proyectos' }]}><span class="nav-index">01</span><span class="nav-text" data-text={d.ui.nav1}>{d.ui.nav1}</span></a>
          <a href={`${p}/#experiencia`} class="nav-link"><span class="nav-index">02</span><span class="nav-text" data-text={d.ui.nav2}>{d.ui.nav2}</span></a>
          <a href={`${p}/#formacion`} class="nav-link"><span class="nav-index">03</span><span class="nav-text" data-text={d.ui.nav3}>{d.ui.nav3}</span></a>
          <a href={`${p}/#contacto`} class="nav-link"><span class="nav-index">04</span><span class="nav-text" data-text={d.ui.nav4}>{d.ui.nav4}</span></a>
        </nav>
        <div class="nav-actions">
          <a href={root + d.ui.switchHref} class="lang">{d.ui.switchLabel}</a>
          <a href={`${p}/#contacto`} class="cta">{d.ui.contact}</a>
        </div>
      </div>
    </header>
    <slot />
    <footer class="bottom-bar">
      <span class="mono">© {new Date().getFullYear()} {d.profile.name}</span>
      <span class="mono">{d.ext.footer}</span>
    </footer>
    <script>
      function reveal() {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal:not(.in), .tl-list:not(.in), .job:not(.in)')
          .forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', reveal);
      const onScroll = () => {
        document.querySelector('.nav')?.classList.toggle('scrolled', window.scrollY > 20);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('astro:page-load', onScroll);
    </script>
  </body>
</html>
