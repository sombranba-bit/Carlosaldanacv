---
import Base from '../layouts/Base.astro';
import * as es from '../data/cv';
import * as en from '../data/cv.en';
import { detail } from '../data/projects-detail';
import { appIcons, vehicles } from '../data/icons';

interface Props { lang: 'es' | 'en'; i: number; }
const { lang, i } = Astro.props;
const d = lang === 'en' ? en : es;
const p = d.projects[i];
const info = detail[lang][i];
// Solo la herramienta con demo lleva la línea de recorrido con pantallas de panel; el resto muestra sus puntos en texto
const dashboard = info.slug === 'panel-infracciones';
const tone = info.tone;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const base = root + d.ui.prefix;
const back = lang === 'en' ? '← All projects' : '← Todos los proyectos';
const contactLabel = lang === 'en' ? 'Contact' : 'Contacto';
const laneNames = lang === 'en' ? ['Rigid truck', 'Curtain-sider', 'Tipper', 'Crane truck', 'Tanker'] : ['Camión rígido', 'Camión de lona', 'Volquete', 'Camión con grúa', 'Camión cisterna'];
const laneKeys = ['rigid', 'lona', 'volquete', 'grua', 'cisterna'] as const;
const trs_es = [['03 oct','M. Sánchez','Descanso','400 €'],['05 oct','R. Gil','Velocidad','200 €'],['09 oct','A. Ortega','Tacógrafo','1.200 €'],['14 oct','L. Navarro','Descanso','400 €']];
const trs_en = [['Oct 3','M. Sánchez','Rest','400 €'],['Oct 5','R. Gil','Speed','200 €'],['Oct 9','A. Ortega','Tachograph','1,200 €'],['Oct 14','L. Navarro','Rest','400 €']];
const mk = lang === 'en'
  ? { k1: 'Infringements', k2: 'Downloads', k3: 'Repeat', cap0: 'Infringements per month', cap1: '2026 · 2025', s1: 'peak · Jun', s2: 'Oct vs 2025', ax: ['Jan', 'Mar', 'May', 'Jul', 'Sep', 'Oct'], cap2: 'Drivers with most infringements', cap3: 'Infringements by delegation',
      cap4: 'Fleet IRI index (scale 0–5)', gauge: 'IRI · alert above 3', hi: 'Serious >3', mid: 'Medium 1.5–3', lo: 'Low <1.5', search: 'Search driver…', type: 'Type', th0: 'Date', th1: 'Driver', th2: 'Type', th3: 'Amount', cap6: 'This month vs last', goal: 'Target 95%', c1: 'Infringements', c2: 'Downloads OK', c3: 'Repeat', cap7: 'Warnings sent to drivers this week', name0: 'M. Sánchez', name1: 'R. Gil', name2: 'A. Ortega', name3: 'D. Serrano', name4: 'J. Morales', name5: 'Delegation BIL', name6: 'Delegation SVQ', name7: 'Delegation ZGZ', st_sent: 'Sent', st_pending: 'Pending', st_read: 'Read', lang: 'en' }
  : { k1: 'Infracciones', k2: 'Descargas', k3: 'Reincidentes', cap0: 'Infracciones por mes', cap1: '2026 · 2025', s1: 'pico · jun', s2: 'oct vs 2025', ax: ['ene', 'mar', 'may', 'jul', 'sep', 'oct'], cap2: 'Conductores con más infracciones', cap3: 'Infracciones por delegación',
      cap4: 'Índice IRI de la flota (escala 0–5)', gauge: 'IRI · alerta por encima de 3', hi: 'Grave >3', mid: 'Medio 1,5–3', lo: 'Bajo <1,5', search: 'Buscar conductor…', type: 'Tipo', th0: 'Fecha', th1: 'Conductor', th2: 'Tipo', th3: 'Importe', cap6: 'Mes actual frente al anterior', goal: 'Objetivo 95%', c1: 'Infracciones', c2: 'Descargas OK', c3: 'Reincidentes', cap7: 'Avisos a conductores esta semana', name0: 'M. Sánchez', name1: 'R. Gil', name2: 'A. Ortega', name3: 'D. Serrano', name4: 'J. Morales', name5: 'Delegación BIL', name6: 'Delegación SVQ', name7: 'Delegación ZGZ', st_sent: 'Enviado', st_pending: 'Pendiente', st_read: 'Leído', lang: 'es' };
const live = lang === 'en' ? 'Try the interactive demo' : 'Ver demo interactiva';
// Imagen real de archivo para cada herramienta, con su crédito (Wikimedia Commons)
const photos = {
  'panel-infracciones': { src: '/img/tachograph.jpg', alt: lang === 'en' ? 'Tachograph in a truck cab with a chart disc being inserted' : 'Tacógrafo en cabina de camión con un disco de registro introduciéndose', credit: lang === 'en' ? 'Photo: “Tachograph” by Paettchen (Patrick Seidler), CC BY-SA 3.0, via Wikimedia Commons.' : 'Foto: “Tachograph” de Paettchen (Patrick Seidler), CC BY-SA 3.0, vía Wikimedia Commons.' },
  'cruce-descargas': { src: '/img/tachograafschijf-voorkant.webp', alt: lang === 'en' ? 'Tachograph chart disc, front side' : 'Disco de registro del tacógrafo, cara frontal', credit: lang === 'en' ? 'Photo: “Tachograafschijf voorkant”, public domain, via Wikimedia Commons.' : 'Foto: “Tachograafschijf voorkant”, dominio público, vía Wikimedia Commons.' },
  'lector-tgd': { src: '/img/lkw-tachograph-aufgeklappt-bj-1958.jpg', alt: lang === 'en' ? 'Analogue tachograph from 1958 with its cover open' : 'Tacógrafo analógico de 1958 con la tapa abierta', credit: lang === 'en' ? 'Photo: “LKW-Tachograph aufgeklappt Bj.1958” by selbst, public domain, via Wikimedia Commons.' : 'Foto: “LKW-Tachograph aufgeklappt Bj.1958” de selbst, dominio público, vía Wikimedia Commons.' },
}[info.slug];
---
<Base title={`${p.name} · ${d.profile.name}`} active="proyectos" lang={lang} description={info.tagline ? `${p.name}. ${info.tagline}` : undefined} image={info.shot ?? photos?.src} jsonld={{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: p.name, description: info.body, applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, author: { '@type': 'Person', name: d.profile.name } }}>
  <section class="section detail" style={`--tone:${tone}`}>
    <div class="detail-art" aria-hidden="true"></div>
    <a class="detail-back" href={`${base}/proyectos`}>{back}</a>
    <div class={info.stage === false ? "detail-split solo" : "detail-split"}>
      <div class="detail-text">
        <div class="detail-head">
          <span class="app-icon is-pro detail-icon" data-tone={i} set:html={appIcons[i]} />
          <div>
            <h1>{p.name}</h1>
            <p class="detail-tagline">{info.tagline}</p>
          </div>
        </div>
        <p class="detail-body">{info.body}</p>
        <p class="detail-note">{info.note}</p>
        <ul class="detail-chips">
          <li class="chip chip-year">{info.year}</li>
          {p.tags.map((t) => <li class="chip">{t}</li>)}
        </ul>
        {info.demo && <p class="detail-live"><a class="btn btn-primary magnetic" href={root + info.demo}>{live} <span aria-hidden="true">→</span></a></p>}
        {info.app && <p class="detail-live"><a class="btn btn-primary magnetic app-open" style={`background:${tone};color:#0b0b0b`} href={root + info.app} target="_blank" rel="noopener">{info.appLabel}</a></p>}
        <p class="detail-disclaimer">{info.disclaimer}</p>
      </div>
      {info.stage !== false && (
        <aside class="detail-stage">
          {info.demo ? (
            <div class="device">
              <div class="device-bar"><span></span><span></span><span></span></div>
              <iframe class="device-screen" src={root + info.demo} title={p.name} loading="lazy"></iframe>
            </div>
          ) : info.shot ? (
            <div class="device device-shot">
              <img src={root + info.shot} alt={lang === 'en' ? `${p.name} screen: download summary by driver and vehicle` : `Pantalla de ${p.name}: resumen de descargas por conductor y vehículo`} loading="lazy" />
            </div>
          ) : (
            <div class="device device-icon">
              <span class="app-icon is-pro" data-tone={i} set:html={appIcons[i]} />
            </div>
          )}
          {!dashboard && info.summary && (
            <section class="detail-summary">
              <p>{info.summary}</p>
            </section>
          )}
        </aside>
      )}
    </div>

    {dashboard && <div class="tl-lanes" aria-hidden="true">
      {laneNames.map((name, k) => (
        <div class="tl-lane" data-dir={k % 2 ? 'rev' : 'fwd'}>
          <span class="tl-lane-label">{name}</span>
          <div class="tl-lane-track">
            <div class="tl-lane-road"></div>
            {info.features.map((f, n) => { const x = ((n + 1) / (info.features.length + 1)) * 100; return <span class="tl-lane-stop" data-at={x} style={`left:${x}%`}></span>; })}
            <span class="tl-lane-veh" set:html={vehicles[laneKeys[k]]}></span>
          </div>
        </div>
      ))}
    </div>}
    {dashboard && <div class="tl-grid">
      <div class="tl-copy">
        <div class="tl-rail" aria-hidden="true"><div class="tl-rail-fill"></div><span class="tl-truck"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2" y="7" width="12" height="9" rx="1"/><path d="M14 10h4l3 3v3h-7"/><circle cx="6" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg></span></div>
        <ol class="tl-chapters">
          {info.features.map((f, n) => (
            <li class="tl-chapter" data-zone={n % 8} data-cat={f.cat}>
              <span class="tl-stop" aria-hidden="true"></span>
              <span class="tl-num">{String(n + 1).padStart(2, '0')}</span>
              <h3>{f.cat}</h3>
              <p>{f.title}</p>
            </li>
          ))}
        </ol>
      </div>
      {dashboard && <div class="tl-stage">
        <div class="tl-sticky" data-zone="0">
          <div class="phone">
            <div class="phone-island"></div>
            <div class="phone-screen">
              <div class="mock-bar"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
              <div class="zone z0"><span class="zone-label"></span><div class="mock-kpis"><div style="--d:0ms"><b>1.284</b><small>{mk.k1}</small></div><div style="--d:120ms"><b>94%</b><small>{mk.k2}</small></div><div style="--d:240ms"><b>27</b><small>{mk.k3}</small></div></div><span class="mock-cap">{mk.cap0}</span><div class="mock-bars"><i style="--h:42%;--d:0ms"></i><i style="--h:55%;--d:70ms"></i><i style="--h:38%;--d:140ms"></i><i style="--h:61%;--d:210ms"></i><i style="--h:48%;--d:280ms"></i><i style="--h:72%;--d:350ms"></i><i style="--h:66%;--d:420ms"></i><i style="--h:58%;--d:490ms"></i><i style="--h:44%;--d:560ms"></i><i style="--h:69%;--d:630ms"></i></div></div>
              <div class="zone z1"><span class="zone-label"></span><div class="mock-stats"><div><b>72</b><small>{mk.s1}</small></div><div><b class="ok">+11%</b><small>{mk.s2}</small></div></div><svg class="mock-spark" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="spk" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--tone)" stop-opacity=".28"/><stop offset="1" stop-color="var(--tone)" stop-opacity="0"/></linearGradient></defs><path d="M0 10H100M0 20H100M0 30H100" stroke="#ffffff10" fill="none" vector-effect="non-scaling-stroke"/><path class="spk-area" d="M0.0 28.0 L11.11 21.5 L22.22 30.0 L33.33 18.5 L44.44 25.0 L55.56 13.0 L66.67 16.0 L77.78 20.0 L88.89 27.0 L100.0 14.5 L100 40 L0 40 Z" fill="url(#spk)"/><path class="spk-line" pathLength="1" d="M0.0 28.0 L11.11 21.5 L22.22 30.0 L33.33 18.5 L44.44 25.0 L55.56 13.0 L66.67 16.0 L77.78 20.0 L88.89 27.0 L100.0 14.5" fill="none" stroke="var(--tone)" stroke-width="1.6" stroke-linejoin="round"/><path class="spk-dash" d="M0.0 24.0 L11.11 25.5 L22.22 22.0 L33.33 23.0 L44.44 19.0 L55.56 20.0 L66.67 17.5 L77.78 21.5 L88.89 24.0 L100.0 18.0" fill="none" stroke="#ffffff55" stroke-width="1.2" stroke-dasharray="3 3" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg><div class="mock-legend2"><span><i></i>{mk.cap1.split(" · ")[0]}</span><span><i class="dash"></i>{mk.cap1.split(" · ")[1]}</span></div><div class="mock-axis"><span>{mk.ax[0]}</span><span>{mk.ax[1]}</span><span>{mk.ax[2]}</span><span>{mk.ax[3]}</span><span>{mk.ax[4]}</span><span>{mk.ax[5]}</span></div></div>
              <div class="zone z2"><span class="zone-label"></span><span class="mock-cap">{mk.cap2}</span><div class="mock-rows"><p style="--d:200ms"><i></i><span>M. Sánchez</span><em>ZGZ</em><strong>14</strong></p><p style="--d:290ms"><i></i><span>R. Gil</span><em>MAD</em><strong>11</strong></p><p style="--d:380ms"><i></i><span>A. Ortega</span><em>BCN</em><strong>9</strong></p><p style="--d:470ms"><i></i><span>L. Navarro</span><em>ZGZ</em><strong>7</strong></p><p style="--d:560ms"><i></i><span>D. Serrano</span><em>VLC</em><strong>6</strong></p></div></div>
              <div class="zone z4"><span class="zone-label"></span><span class="mock-cap">{mk.cap3}</span><div class="mock-deleg"><p style="--d:200ms"><span>Zaragoza</span><i style="--w:92%;--d:300ms"></i><b>412</b></p><p style="--d:340ms"><span>Madrid</span><i style="--w:72%;--d:440ms"></i><b>318</b></p><p style="--d:480ms"><span>Barcelona</span><i style="--w:58%;--d:580ms"></i><b>256</b></p><p style="--d:620ms"><span>Valencia</span><i style="--w:34%;--d:720ms"></i><b>147</b></p><p style="--d:760ms"><span>Bilbao</span><i style="--w:26%;--d:860ms"></i><b>118</b></p></div></div>
              <div class="zone z3"><span class="zone-label"></span><span class="mock-cap">{mk.cap4}</span><div class="mock-gauge"><svg viewBox="0 0 120 66" aria-hidden="true"><path d="M10 60 A50 50 0 0 1 110 60" pathLength="1" fill="none" stroke="#ffffff14" stroke-width="9" stroke-linecap="round"/><path class="gauge-val" d="M10 60 A50 50 0 0 1 110 60" pathLength="1" fill="none" stroke="var(--tone)" stroke-width="9" stroke-linecap="round"/></svg><div class="gauge-num"><b>2,4</b><small>{mk.gauge}</small></div></div><div class="mock-legend"><p style="--d:700ms"><i class="h"></i><span>{mk.hi}</span><b>2</b></p><p style="--d:800ms"><i class="m"></i><span>{mk.mid}</span><b>5</b></p><p style="--d:900ms"><i class="l"></i><span>{mk.lo}</span><b>9</b></p></div></div>
              <div class="zone z5"><span class="zone-label"></span><div class="mock-search"><span>{mk.search}</span><em>{mk.type} ▾</em></div><div class="mock-table"><div class="th"><span>{mk.th0}</span><span>{mk.th1}</span><span>{mk.th2}</span><span>{mk.th3}</span></div>{(mk.lang === "en" ? trs_en : trs_es).map(([a, b, c, d], i) => <div class="tr" style={`--d:${200 + i * 110}ms`}><span>{a}</span><span>{b}</span><span>{c}</span><span>{d}</span></div>)}</div></div>
              <div class="zone z6"><span class="zone-label"></span><span class="mock-cap">{mk.cap6}</span><div class="mock-compare"><div style="--d:150ms"><span>{mk.c1}</span><b>1.284</b><em class="bad">+4.2%</em></div><div style="--d:300ms"><span>{mk.c2}</span><b>94%</b><em class="ok">+1.1%</em></div><div style="--d:450ms"><span>{mk.c3}</span><b>27</b><em class="ok">−3</em></div></div><div class="mock-donut" style="--d:600ms"><svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15.9" fill="none" stroke="#ffffff14" stroke-width="3.4"/><circle class="donut-val" cx="18" cy="18" r="15.9" pathLength="100" fill="none" stroke="var(--tone)" stroke-width="3.4" stroke-dasharray="94 106" transform="rotate(-90 18 18)"/></svg><div><b>94%</b><small>{mk.c2}</small><small class="mock-goal">{mk.goal}</small></div></div></div>
              <div class="zone z7"><span class="zone-label"></span><span class="mock-cap">{mk.cap7}</span><div class="mock-notes"><p style="--d:200ms"><i class="sent"></i><span>{mk.name0}</span><em class="sent">{mk.st_sent}</em></p><p style="--d:310ms"><i class="pending"></i><span>{mk.name1}</span><em class="pending">{mk.st_pending}</em></p><p style="--d:420ms"><i class="read"></i><span>{mk.name2}</span><em class="read">{mk.st_read}</em></p><p style="--d:530ms"><i class="sent"></i><span>{mk.name3}</span><em class="sent">{mk.st_sent}</em></p><p style="--d:640ms"><i class="read"></i><span>{mk.name4}</span><em class="read">{mk.st_read}</em></p></div></div>
            </div>
          </div>
        </div>
      </div>}
    </div>}

    {photos && (
      <figure class="detail-photo reveal">
        <img src={root + photos.src} alt={photos.alt} width="1024" height="768" loading="lazy" decoding="async" />
        <figcaption>{photos.credit}</figcaption>
      </figure>
    )}
    {info.shots.length > 0 && (
      <div class="detail-shots reveal">
        {info.shots.map((src, k) => <img src={root + src} alt={lang === 'en' ? `${p.name} screenshot ${k + 1}` : `Captura ${k + 1} de ${p.name}`} loading="lazy" />)}
      </div>
    )}

    <div class="detail-contact reveal">
      <button type="button" class="cta-block" data-reveal={btoa(d.profile.email)}>
        <span class="cta-line cta-sans">{d.ext.contactA}</span>
        <span class="cta-line cta-serif">{d.ext.contactB}</span>
      </button>
      <ul class="socials">
        <li><span class="email-out"><button type="button" class="social-link email-reveal" data-reveal={btoa(d.profile.email)}><span class="social-text" data-text={d.ui.showEmail}>{d.ui.showEmail}</span></button></span> <button type="button" class="copy-btn" hidden data-label-copy={d.ui.copyEmail} data-label-done={d.ui.copied}>{d.ui.copyEmail}</button></li>
        <li><a class="social-link" href={`tel:${d.profile.phoneHref}`}><span class="social-text" data-text={d.profile.phone}>{d.profile.phone}</span></a></li>
        <li><a class="social-link" href={d.profile.linkedin} target="_blank" rel="noopener"><span class="social-text" data-text="LinkedIn">LinkedIn</span><span class="social-arrow">↗</span></a></li>
        <li><a class="social-link" href={root + "/cv.pdf"} download><span class="social-text" data-text={d.ui.cv}>{d.ui.cv}</span><span class="social-arrow">↓</span></a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  function timeline() {
    const chapters = [...document.querySelectorAll('.tl-chapter')];
    const sticky = document.querySelector('.tl-sticky');
    const fill = document.querySelector('.tl-rail-fill');
    const truck = document.querySelector('.tl-truck');
    const copy = document.querySelector('.tl-copy');
    const lanesEl = document.querySelector('.tl-lanes');
    const phoneEl = document.querySelector('.tl-sticky .phone');
    const fitPhone = () => { if (phoneEl) phoneEl.style.zoom = Math.min(1, (document.querySelector('.tl-stage')?.clientWidth ?? 0) / 560); };
    fitPhone();
    addEventListener('resize', fitPhone);
    if (!chapters.length || !sticky || !copy) return;
    const update = () => {
      const mid = innerHeight * 0.5;
      let active = 0;
      chapters.forEach((c, n) => {
        const r = c.getBoundingClientRect();
        if (r.top < mid) active = n;
        c.classList.toggle('is-reached', r.top < mid);
      });
      const c = chapters[active];
      chapters.forEach((x, n) => x.classList.toggle('is-active', n === active));
      sticky.dataset.zone = c.dataset.zone;
      sticky.querySelectorAll('.mock-bar span').forEach((t, i) => t.classList.toggle('on', i === Number(c.dataset.zone)));
      sticky.querySelectorAll('.zone').forEach((z) => {
        const on = z.classList.contains('z' + c.dataset.zone);
        z.classList.toggle('is-active', on);
        z.querySelector('.zone-label').textContent = on ? c.dataset.cat : '';
      });
      const r = copy.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      if (fill) fill.style.transform = `scaleY(${p})`;
      if (truck) truck.style.top = `${p * 100}%`;
      if (lanesEl) {
        const lr = lanesEl.getBoundingClientRect();
        const lp = Math.min(1, Math.max(0, (mid - lr.top) / (lr.height + mid)));
        lanesEl.querySelectorAll('.tl-lane').forEach((ln) => {
          const pos = ln.dataset.dir === 'rev' ? 1 - lp : lp;
          ln.querySelector('.tl-lane-track').style.setProperty('--p', pos.toFixed(4));
          ln.querySelectorAll('.tl-lane-stop').forEach((st) => {
            st.classList.toggle('is-passed', pos * 100 >= parseFloat(st.dataset.at));
          });
        });
      }
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
  function fx() {
    const dev = document.querySelector('.device');
    if (!dev) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { threshold: 0.2 });
    io.observe(dev);
  }
  function shots() {
    document.querySelectorAll('.shots').forEach((box) => {
      const track = box.querySelector('.shots-track');
      const slides = [...track.querySelectorAll('img')];
      const dotsEl = box.querySelector('.shots-dots');
      const dots = slides.map((_, n) => {
        const d = document.createElement('button');
        d.type = 'button';
        d.setAttribute('aria-label', 'Diapositiva ' + (n + 1));
        d.onclick = () => go(n);
        dotsEl.append(d);
        return d;
      });
      const width = () => track.clientWidth;
      const current = () => Math.round(track.scrollLeft / width());
      const go = (n) => {
        const i = ((n % slides.length) + slides.length) % slides.length;
        track.scrollTo({ left: i * width(), behavior: 'smooth' });
      };
      const mark = () => dots.forEach((d, n) => d.classList.toggle('on', n === current()));
      let timer = null;
      const start = () => { stop(); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(() => go(current() + 1), 5000); };
      const stop = () => clearInterval(timer);
      box.querySelector('.shots-prev').onclick = () => { go(current() - 1); start(); };
      box.querySelector('.shots-next').onclick = () => { go(current() + 1); start(); };
      track.addEventListener('scroll', mark, { passive: true });
      box.addEventListener('pointerenter', stop);
      box.addEventListener('pointerleave', start);
      mark();
      start();
    });
  }
  document.addEventListener('astro:page-load', () => { timeline(); fx(); shots(); });
</script>
