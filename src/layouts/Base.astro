---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import * as es from '../data/cv';
import * as en from '../data/cv.en';

interface Props { title: string; active?: string; lang: 'es' | 'en'; }
const { title, active = '', lang } = Astro.props;
const d = lang === 'en' ? en : es;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = root + d.ui.prefix;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="description" content={`${d.profile.title} · ${d.profile.tagline}`} />
    <title>{title}</title>
    <link rel="icon" href={root + "/avatar.jpg"} />
    <link rel="alternate" hreflang="es" href={root + "/"} />
    <link rel="alternate" hreflang="en" href={root + "/en/"} />
    <ClientRouter />
  </head>
  <body>
    <div class="intro" aria-hidden="true">
      <div class="intro-box">
      <svg viewBox="0 0 200 200">
        <g fill="none" stroke="#ffffff" stroke-width="1">
          <circle class="ring r1" cx="100" cy="100" r="40" pathLength="1" stroke-opacity=".35"/>
          <circle class="ring r2" cx="100" cy="100" r="60" pathLength="1" stroke-opacity=".3"/>
          <circle class="ring r3" cx="100" cy="100" r="80" pathLength="1" stroke-opacity=".25"/>
          <circle class="ring r4" cx="100" cy="100" r="92" pathLength="1" stroke-opacity=".2"/>
          <g class="ticks" stroke-opacity=".5"><line x1="100.0" y1="20.0" x2="100.0" y2="8.0"/><line x1="122.3" y1="16.9" x2="123.8" y2="11.1"/><line x1="143.0" y1="25.5" x2="146.0" y2="20.3"/><line x1="160.8" y1="39.2" x2="165.1" y2="34.9"/><line x1="174.5" y1="57.0" x2="179.7" y2="54.0"/><line x1="183.1" y1="77.7" x2="188.9" y2="76.2"/><line x1="180.0" y1="100.0" x2="192.0" y2="100.0"/><line x1="183.1" y1="122.3" x2="188.9" y2="123.8"/><line x1="174.5" y1="143.0" x2="179.7" y2="146.0"/><line x1="160.8" y1="160.8" x2="165.1" y2="165.1"/><line x1="143.0" y1="174.5" x2="146.0" y2="179.7"/><line x1="122.3" y1="183.1" x2="123.8" y2="188.9"/><line x1="100.0" y1="180.0" x2="100.0" y2="192.0"/><line x1="77.7" y1="183.1" x2="76.2" y2="188.9"/><line x1="57.0" y1="174.5" x2="54.0" y2="179.7"/><line x1="39.2" y1="160.8" x2="34.9" y2="165.1"/><line x1="25.5" y1="143.0" x2="20.3" y2="146.0"/><line x1="16.9" y1="122.3" x2="11.1" y2="123.8"/><line x1="20.0" y1="100.0" x2="8.0" y2="100.0"/><line x1="16.9" y1="77.7" x2="11.1" y2="76.2"/><line x1="25.5" y1="57.0" x2="20.3" y2="54.0"/><line x1="39.2" y1="39.2" x2="34.9" y2="34.9"/><line x1="57.0" y1="25.5" x2="54.0" y2="20.3"/><line x1="77.7" y1="16.9" x2="76.2" y2="11.1"/></g>
          <g class="dial-labels" stroke="none"><text x="100.0" y="52.0" font-size="6" fill="#fff" fill-opacity=".5" text-anchor="middle" font-family="JetBrains Mono, monospace">00</text><text x="150.0" y="102.0" font-size="6" fill="#fff" fill-opacity=".5" text-anchor="middle" font-family="JetBrains Mono, monospace">06</text><text x="100.0" y="152.0" font-size="6" fill="#fff" fill-opacity=".5" text-anchor="middle" font-family="JetBrains Mono, monospace">12</text><text x="50.0" y="102.0" font-size="6" fill="#fff" fill-opacity=".5" text-anchor="middle" font-family="JetBrains Mono, monospace">18</text><text x="30.0" y="101.6" font-size="4" fill="#fff" fill-opacity=".35" text-anchor="middle" font-family="JetBrains Mono, monospace">20</text><text x="50.5" y="52.1" font-size="4" fill="#fff" fill-opacity=".35" text-anchor="middle" font-family="JetBrains Mono, monospace">40</text><text x="100.0" y="31.6" font-size="4" fill="#fff" fill-opacity=".35" text-anchor="middle" font-family="JetBrains Mono, monospace">60</text><text x="149.5" y="52.1" font-size="4" fill="#fff" fill-opacity=".35" text-anchor="middle" font-family="JetBrains Mono, monospace">80</text><text x="170.0" y="101.6" font-size="4" fill="#fff" fill-opacity=".35" text-anchor="middle" font-family="JetBrains Mono, monospace">100</text><text x="149.5" y="151.1" font-size="4" fill="#fff" fill-opacity=".35" text-anchor="middle" font-family="JetBrains Mono, monospace">120</text></g>
          <line class="hand" x1="100" y1="100" x2="100" y2="14" stroke="#ffb000" stroke-width="1.6"/>
        </g>
      </svg>
      <p class="intro-text"><span class="intro-name">{d.profile.name}</span><span class="intro-role">{d.profile.title}</span></p>
      </div>
    </div>
    <div class="background" aria-hidden="true"><div class="glow"></div><div class="grid" style={`background-image:url(${root}/fondo-tacografo.svg)`}></div></div>
    <header class="nav">
      <div class="nav-inner">
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={d.ui.menu}><span aria-hidden="true"></span></button>
        <a href={`${p}/`} class="brand" aria-label={d.profile.name}>
        </a>
        <nav class="nav-list" id="site-menu">
          <a href={`${p}/proyectos`} class:list={['nav-link', { active: active === 'proyectos' }]}><span class="nav-index">01</span><span class="nav-text" data-text={d.ui.nav1}>{d.ui.nav1}</span></a>
          <a href={`${p}/#experiencia`} class="nav-link"><span class="nav-index">02</span><span class="nav-text" data-text={d.ui.nav2}>{d.ui.nav2}</span></a>
          <a href={`${p}/#formacion`} class="nav-link"><span class="nav-index">03</span><span class="nav-text" data-text={d.ui.nav3}>{d.ui.nav3}</span></a>
          <a href={`${p}/#contacto`} class="nav-link"><span class="nav-index">04</span><span class="nav-text" data-text={d.ui.nav4}>{d.ui.nav4}</span></a>
        </nav>
        <div class="nav-actions">
          <a href={root + d.ui.switchHref} class="lang">{d.ui.switchLabel}</a>
          <a href={`${p}/#contacto`} class="cta magnetic">{d.ui.contact}</a>
        </div>
      </div>
    </header>
    <script>
      if (!window.__menuBound) {
        window.__menuBound = true;
        const setOpen = (open) => {
          const h = document.querySelector('.nav');
          if (!h) return;
          h.classList.toggle('is-open', open);
          h.querySelector('.menu-btn')?.setAttribute('aria-expanded', String(open));
        };
        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          if (t.closest('.menu-btn')) setOpen(!document.querySelector('.nav')?.classList.contains('is-open'));
          else if (t.closest('.nav-list a')) setOpen(false);
          else if (!t.closest('.nav')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
      }
    </script>
    <slot />
    
    <footer class="bottom-bar">
      <span class="mono">© {new Date().getFullYear()} {d.profile.name}</span>
      <span class="mono">{d.ext.footer}</span>
    </footer>
    <script>
      // Botones que siguen ligeramente al cursor
      function magnetic() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(pointer: coarse)').matches) return;
        document.querySelectorAll('.magnetic').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            cancelAnimationFrame(el._raf);
            el._raf = requestAnimationFrame(() => {
              const r = el.getBoundingClientRect();
              el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.2}px, ${(e.clientY - r.top - r.height / 2) * 0.25}px)`;
            });
          });
          el.addEventListener('mouseleave', () => { el.style.transform = ''; });
        });
      }
      document.addEventListener('astro:page-load', magnetic);
      // La intro solo se ve una vez por sesión
      function intro() {
        const el = document.querySelector('.intro');
        if (!el) return;
        const key = 'intro-ok-' + document.documentElement.lang;
        let seen = false;
        try { seen = sessionStorage.getItem(key) === '1'; sessionStorage.setItem(key, '1'); } catch (e) {}
        if (seen || location.pathname.includes('/proyectos/') || matchMedia('(prefers-reduced-motion: reduce)').matches) el.remove();
      }
      document.addEventListener('astro:page-load', intro);

      function reveal() {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal:not(.in), .tl-list:not(.in), .job:not(.in)')
          .forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', reveal);
      const onScroll = () => {
        document.querySelector('.nav')?.classList.toggle('scrolled', window.scrollY > 20);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('astro:page-load', onScroll);
    </script>
</body>
</html>
