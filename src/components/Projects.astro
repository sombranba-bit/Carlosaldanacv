---
import Base from '../layouts/Base.astro';
import * as es from '../data/cv';
import * as en from '../data/cv.en';

interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const { projects, ui, profile } = lang === 'en' ? en : es;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const initials = (s: string) => s.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<Base title={`${ui.projectsTitle} · ${profile.name}`} active="proyectos" lang={lang}>
  <section class="section" style="padding-top:180px">
    <div class="section-head reveal">
      <span class="section-no">01</span>
      <div>
        <h1 class="gradient" style="font-size:clamp(2.4rem,5vw,3.6rem);letter-spacing:-.03em">{ui.projectsTitle}</h1>
        <p class="section-sub">{ui.projectsLead}</p>
      </div>
    </div>
    <div class="grid-cards">
      {projects.map((p, i) => (
        <article class="project-card reveal" style={`--d:${(i % 3) * 0.1}s`}>
          <div class="thumb"><span class="thumb-mark">{initials(p.name)}</span></div>
          <div class="card-body">
            <h3>{p.name}</h3>
            <p class="summary">{p.desc}</p>
            <ul class="tech">{p.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
    <div class="view-all-wrap">
      <a class="view-all" href={`${root}${ui.prefix}/`}>{ui.back}</a>
    </div>
  </section>
</Base>
