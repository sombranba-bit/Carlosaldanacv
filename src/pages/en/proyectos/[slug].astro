---
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { detail } from '../../../data/projects-detail';

export function getStaticPaths() {
  return detail.en.map((d, i) => ({ params: { slug: d.slug }, props: { i } }));
}
const { i } = Astro.props;
---
<ProjectDetail lang="en" i={i} />
